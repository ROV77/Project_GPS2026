@host = http://localhost:3000

### Health check
GET {{host}}/health

### Listar categorías
GET {{host}}/api/categories

### Listar categorías paginadas
GET {{host}}/api/categories?page=1&limit=5

### Obtener una categoría
GET {{host}}/api/categories/1

### Crear categoría (válida → 201)
POST {{host}}/api/categories
Content-Type: application/json

{
  "name": "Pastelería"
}

### Crear categoría inválida (sin name → 400)
POST {{host}}/api/categories
Content-Type: application/json

{}

### Actualizar categoría
PUT {{host}}/api/categories/1
Content-Type: application/json

{
  "name": "Panadería Artesanal"
}

### Eliminar categoría
DELETE {{host}}/api/categories/1

### Listar regiones
GET {{host}}/api/regions

### Listar planes
GET {{host}}/api/plans

### Listar tiendas
GET {{host}}/api/stores

### Obtener una tienda
GET {{host}}/api/stores/1

### Crear tienda (FK válida → 201)
POST {{host}}/api/stores
Content-Type: application/json

{
  "owner_id": 1,
  "name": "Verdulería Don José",
  "category_id": 2,
  "region_id": 1,
  "commune_id": 1
}

### Crear tienda con owner inexistente (FK inválida → 409)
POST {{host}}/api/stores
Content-Type: application/json

{
  "owner_id": 999999,
  "name": "Tienda Fantasma"
}

### Listar productos
GET {{host}}/api/products

### Crear producto (válido → 201)
POST {{host}}/api/products
Content-Type: application/json

{
  "store_id": 1,
  "name": "Empanada de pino",
  "price": 2500,
  "stock": 30
}

### Crear producto inválido (sin store_id → 400)
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "Sin tienda"
}
