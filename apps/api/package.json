{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:reset": "prisma migrate reset --force && tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@caserita/validations": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "~3.0.2",
    "cloudinary": "~2.6.0",
    "cors": "~2.8.5",
    "dotenv": "~16.5.0",
    "express": "~5.1.0",
    "jsonwebtoken": "~9.0.2",
    "mercadopago": "^3.2.0",
    "multer": "~1.4.5-lts.1",
    "zod": "~3.24.0"
  },
  "devDependencies": {
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/jsonwebtoken": "~9.0.0",
    "@types/multer": "~1.4.11",
    "@types/node": "~22.0.0",
    "prisma": "6.19.3",
    "tsx": "~4.19.0",
    "typescript": "~5.9.2"
  }
}
