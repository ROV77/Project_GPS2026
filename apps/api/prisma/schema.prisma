generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  region_id  BigInt?
  commune_id BigInt?
  street     String?
  number     String?   @db.VarChar(20)
  apartment  String?
  reference  String?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  metadata   Json?
  communes   communes? @relation(fields: [commune_id], references: [id], onUpdate: NoAction, map: "fk_addresses_commune")
  regions    regions?  @relation(fields: [region_id], references: [id], onUpdate: NoAction, map: "fk_addresses_region")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_addresses_user")

  @@index([commune_id], map: "idx_addresses_commune")
  @@index([region_id], map: "idx_addresses_region")
  @@index([user_id], map: "idx_addresses_user")
}

model categories {
  id     BigInt   @id @default(autoincrement())
  name   String
  stores stores[]
}

model communes {
  id        BigInt      @id @default(autoincrement())
  region_id BigInt?
  name      String
  city      String?
  addresses addresses[]
  regions   regions?    @relation(fields: [region_id], references: [id], onUpdate: NoAction, map: "fk_communes_region")
  stores    stores[]

  @@index([region_id], map: "idx_communes_region")
  @@index([region_id, name], map: "idx_communes_region_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model courier_ratings {
  id         BigInt   @id @default(autoincrement())
  courier_id BigInt
  store_id   BigInt
  stars      Int?     @db.SmallInt
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [courier_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_courierratings_courier")
  stores     stores   @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_courierratings_store")

  @@index([courier_id], map: "idx_courierratings_courier")
  @@index([store_id], map: "idx_courierratings_store")
}

model delivery_applications {
  id                           BigInt                        @id @default(autoincrement())
  vacancy_id                   BigInt
  courier_id                   BigInt
  state_id                     BigInt?
  applied_at                   DateTime                      @default(now()) @db.Timestamptz(6)
  users                        users                         @relation(fields: [courier_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_applications_courier")
  delivery_applications_states delivery_applications_states? @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_applications_state")
  delivery_vacancies           delivery_vacancies            @relation(fields: [vacancy_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_applications_vacancy")

  @@unique([vacancy_id, courier_id])
  @@index([courier_id], map: "idx_applications_courier")
  @@index([state_id], map: "idx_applications_state")
  @@index([vacancy_id], map: "idx_applications_vacancy")
}

model delivery_applications_states {
  id                    BigInt                  @id @default(autoincrement())
  name                  String                  @unique
  delivery_applications delivery_applications[]
}

model delivery_vacancies {
  id                        BigInt                     @id @default(autoincrement())
  store_id                  BigInt
  description               String?
  state_id                  BigInt?
  created_at                DateTime                   @default(now()) @db.Timestamptz(6)
  delivery_applications     delivery_applications[]
  delivery_vacancies_states delivery_vacancies_states? @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_vacancies_state")
  stores                    stores                     @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_vacancies_store")

  @@index([state_id], map: "idx_vacancies_state")
  @@index([store_id], map: "idx_vacancies_store")
}

model delivery_vacancies_states {
  id                 BigInt               @id @default(autoincrement())
  name               String               @unique
  delivery_vacancies delivery_vacancies[]
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  title      String?
  body       String?
  type       String?
  is_read    Boolean   @default(false)
  read_at    DateTime? @db.Timestamptz(6)
  metadata   Json?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([user_id], map: "idx_notifications_user")
}

model payments {
  id              BigInt           @id @default(autoincrement())
  subscription_id BigInt
  amount          Decimal?         @db.Decimal(12, 2)
  currency        String?          @default("CLP") @db.VarChar(3)
  state_id        BigInt?
  paid_at         DateTime?        @db.Timestamptz(6)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  payments_states payments_states? @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_payments_state")
  subscriptions   subscriptions    @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_subscription")

  @@index([state_id], map: "idx_payments_state")
  @@index([subscription_id], map: "idx_payments_subscription")
}

model payments_states {
  id       BigInt     @id @default(autoincrement())
  name     String     @unique
  payments payments[]
}

model plans {
  id             BigInt          @id @default(autoincrement())
  name           String
  price          Decimal         @default(0) @db.Decimal(12, 2)
  billing_period String          @default("monthly")
  description    String?
  max_products   Int?
  features       Json?
  is_active      Boolean         @default(true)
  subscriptions  subscriptions[]
}

model products {
  id          BigInt    @id @default(autoincrement())
  store_id    BigInt
  name        String
  description String?
  price       Decimal   @default(0) @db.Decimal(12, 2)
  stock       Int       @default(0)
  image_url   String?
  featured    Boolean   @default(false)
  updated_at  DateTime?    @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)
  stores      stores       @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_store")
  promotions  promotions[]

  @@index([store_id], map: "idx_products_store")
}

model profile_analytics {
  id           BigInt    @id @default(autoincrement())
  store_id     BigInt
  date         DateTime? @db.Date
  store_visits Int       @default(0)
  stores       stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_analytics_store")

  @@index([store_id], map: "idx_analytics_store")
}

model promotions {
  // Promoción sobre UN producto de la tienda. Dos modalidades, según discount_type:
  //  - 'percentage' → discount_value guarda el % de descuento (1..100).
  //  - '2x1' / '3x2' → promo por cantidad; discount_value queda null.
  // `is_active` permite pausar sin borrar. valid_from/valid_until acotan la
  // vigencia (null = sin límite por ese lado).
  id             BigInt    @id @default(autoincrement())
  store_id       BigInt
  product_id     BigInt
  discount_type  String
  discount_value Decimal?  @db.Decimal(12, 2)
  is_active      Boolean   @default(true)
  valid_from     DateTime? @db.Date
  valid_until    DateTime? @db.Date
  products       products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_promotions_product")
  stores         stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_promotions_store")

  @@index([product_id], map: "idx_promotions_product")
  @@index([store_id], map: "idx_promotions_store")
}

model push_tokens {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  token      String
  platform   String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_pushtokens_user")

  @@unique([user_id, token])
  @@index([user_id], map: "idx_pushtokens_user")
}

model regions {
  id        BigInt      @id @default(autoincrement())
  name      String
  addresses addresses[]
  communes  communes[]
  stores    stores[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id          BigInt   @id @default(autoincrement())
  store_id    BigInt
  customer_id BigInt
  rating      Int      @db.SmallInt
  comment     String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reviews_customer")
  stores      stores   @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reviews_store")

  @@unique([store_id, customer_id])
  @@index([customer_id], map: "idx_reviews_customer")
  @@index([store_id], map: "idx_reviews_store")
}

model roles {
  id         BigInt       @id @default(autoincrement())
  name       String       @unique
  user_roles user_roles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model store_payment_methods {
  id       BigInt @id @default(autoincrement())
  store_id BigInt
  method   String
  stores   stores @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_storepayments_store")

  @@index([store_id], map: "idx_storepayments_store")
}

model store_verifications {
  id                         BigInt                      @id @default(autoincrement())
  store_id                   BigInt
  state_id                   BigInt?
  requested_at               DateTime                    @default(now()) @db.Timestamptz(6)
  reviewed_by                BigInt?
  reviewed_at                DateTime?                   @db.Timestamptz(6)
  review_notes               String?
  users                      users?                      @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "fk_verifications_reviewer")
  store_verifications_states store_verifications_states? @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_verifications_state")
  stores                     stores                      @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_verifications_store")

  @@index([reviewed_by], map: "idx_verifications_reviewer")
  @@index([state_id], map: "idx_verifications_state")
  @@index([store_id], map: "idx_verifications_store")
}

model store_verifications_states {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique
  store_verifications store_verifications[]
}

model stores {
  id                    BigInt                  @id @default(autoincrement())
  owner_id              BigInt
  category_id           BigInt?
  region_id             BigInt?
  commune_id            BigInt?
  name                  String
  description           String?
  logo_url              String?
  verified              Boolean                 @default(false)
  metadata              Json?
  store_phone           String?                 @db.VarChar(20)
  opening_time          DateTime?               @db.Time(6)
  closing_time          DateTime?               @db.Time(6)
  latitude              Decimal?                @db.Decimal(9, 6)
  longitude             Decimal?                @db.Decimal(9, 6)
  courier_ratings       courier_ratings[]
  delivery_vacancies    delivery_vacancies[]
  products              products[]
  profile_analytics     profile_analytics[]
  promotions            promotions[]
  reviews               reviews[]
  store_payment_methods store_payment_methods[]
  store_verifications   store_verifications[]
  categories            categories?             @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_stores_category")
  communes              communes?               @relation(fields: [commune_id], references: [id], onUpdate: NoAction, map: "fk_stores_commune")
  users                 users                   @relation(fields: [owner_id], references: [id], onUpdate: NoAction, map: "fk_stores_owner")
  regions               regions?                @relation(fields: [region_id], references: [id], onUpdate: NoAction, map: "fk_stores_region")
  store_schedules       store_schedules[]
  subscriptions         subscriptions[]

  @@index([category_id], map: "idx_stores_category")
  @@index([commune_id], map: "idx_stores_commune")
  @@index([owner_id], map: "idx_stores_owner")
  @@index([region_id], map: "idx_stores_region")
  @@index([region_id, commune_id], map: "idx_stores_region_commune")
  @@index([region_id, commune_id, category_id], map: "idx_stores_region_commune_category")
}

model store_schedules {
  id           BigInt    @id @default(autoincrement())
  store_id     BigInt
  day_of_week  Int       @db.SmallInt
  is_closed    Boolean   @default(false)
  opening_time DateTime? @db.Time(6)
  closing_time DateTime? @db.Time(6)
  stores       stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_schedules_store")

  @@unique([store_id, day_of_week])
  @@index([store_id], map: "idx_schedules_store")
}

model subscriptions {
  id                   BigInt                @id @default(autoincrement())
  store_id             BigInt
  plan_id              BigInt?
  state_id             BigInt?
  starts_at            DateTime?             @db.Timestamptz(6)
  expires_at           DateTime?             @db.Timestamptz(6)
  payments             payments[]
  plans                plans?                @relation(fields: [plan_id], references: [id], onUpdate: NoAction, map: "fk_subscriptions_plan")
  subscriptions_states subscriptions_states? @relation(fields: [state_id], references: [id], onUpdate: NoAction, map: "fk_subscriptions_state")
  stores               stores                @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_subscriptions_store")

  @@index([plan_id], map: "idx_subscriptions_plan")
  @@index([state_id], map: "idx_subscriptions_state")
  @@index([store_id], map: "idx_subscriptions_store")
}

model subscriptions_states {
  id            BigInt          @id @default(autoincrement())
  name          String          @unique
  subscriptions subscriptions[]
}

model user_roles {
  id      BigInt @id @default(autoincrement())
  role_id BigInt
  user_id BigInt
  roles   roles  @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userroles_role")
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_userroles_user")

  @@unique([user_id, role_id])
  @@index([role_id], map: "idx_userroles_role")
  @@index([user_id], map: "idx_userroles_user")
}

model users {
  id                    BigInt                  @id @default(autoincrement())
  email                 String                  @unique
  password_hash         String
  phone                 String?                 @db.VarChar(20)
  name                  String?
  avatar_url            String?
  email_verified        Boolean                 @default(false)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @db.Timestamptz(6)
  deleted_at            DateTime?               @db.Timestamptz(6)
  addresses             addresses[]
  courier_ratings       courier_ratings[]
  delivery_applications delivery_applications[]
  notifications         notifications[]
  push_tokens           push_tokens[]
  reviews               reviews[]
  store_verifications   store_verifications[]
  stores                stores[]
  user_roles            user_roles[]
}
