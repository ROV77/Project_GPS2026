# Local (pnpm --filter api dev): tu Postgres en localhost.
# Docker (docker compose up): cambia "localhost" por "host.docker.internal"
# (el Postgres del host no es alcanzable como localhost DESDE el contenedor).
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/caseritApp?schema=public"
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT del login. En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Cloudinary (subida de imágenes). Saca los valores de:
# https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# MercadoPago (pago de suscripciones de planes). Usa credenciales de PRUEBA
# (sandbox, pestaña "Credenciales de prueba") de tu app de developers:
# https://www.mercadopago.cl/developers/panel/app
# Detalle completo + tropiezos comunes: docs/planes-y-suscripciones.md §12
MP_ACCESS_TOKEN=

# --- Local (pnpm dev, cada dev con su propio túnel) ---
# WEB_PUBLIC_URL=http://localhost:5173
# API_PUBLIC_URL=https://tu-tunel-personal.ngrok-free.app   (de `ngrok http 3000`)

# --- Docker (docker compose, dominio ngrok fijo compartido del equipo) ---
# Un solo túnel expone todo el stack: usa el MISMO dominio en ambas variables
# (NGROK_DOMAIN del .env de la raíz, con esquema https:// acá).
WEB_PUBLIC_URL=https://tu-dominio.ngrok-free.app
API_PUBLIC_URL=https://tu-dominio.ngrok-free.app
