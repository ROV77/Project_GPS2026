DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/caseritApp?schema=public"
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT del login. En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Cloudinary (subida de imágenes). Saca los valores de:
# https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
