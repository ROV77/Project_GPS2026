DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/caseritApp?schema=public"
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT del login. En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Cloudinary (subida de imágenes). Saca los valores de:
# https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# MercadoPago (pago de suscripciones de planes). Usa credenciales de PRUEBA
# (sandbox) de tu cuenta de developers: https://www.mercadopago.cl/developers/panel/app
MP_ACCESS_TOKEN=TEST-tu-access-token-de-prueba

# A dónde vuelve el navegador tras pagar (panel web).
WEB_PUBLIC_URL=http://localhost:5173
# A dónde le avisa MercadoPago que un pago cambió de estado (esta API). En
# local NO puede ser localhost: MercadoPago necesita alcanzarla desde
# internet, usa un túnel como ngrok (ej. https://xxxx.ngrok-free.app).
API_PUBLIC_URL=https://tu-tunel-publico.ngrok-free.app
