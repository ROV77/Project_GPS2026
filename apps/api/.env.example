# Copia este archivo a ".env" en esta misma carpeta (apps/api/.env) y completa
# los valores. Nunca se commitea (ver .gitignore) — cada quien tiene el suyo.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local (pnpm --filter api dev): tu Postgres en localhost.
# Docker (docker compose up): cambia "localhost" por "host.docker.internal"
# (el Postgres del host no es alcanzable como "localhost" DESDE el contenedor).
# Si aun con host.docker.internal la API no conecta, revisa en el Postgres del
# host: postgresql.conf -> listen_addresses='*' y pg_hba.conf -> una línea que
# permita conexiones desde la red docker (si no, Postgres solo acepta
# localhost real y rechaza las que llegan desde el contenedor).
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/caseritApp?schema=public"

PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT del login. En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Cloudinary (subida de imágenes). Saca los valores de:
# https://console.cloudinary.com/app/settings/api-keys
# Opcional: la API arranca sin esto, solo la ruta de subida responde 503.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ---------------------------------------------------------------------------
# MercadoPago (pago de suscripciones de planes). Usa credenciales de PRUEBA
# (sandbox, pestaña "Credenciales de prueba") de tu app de developers:
# https://www.mercadopago.cl/developers/panel/app
# Opcional: la API arranca sin esto, solo /api/subscriptions/checkout responde
# 503 "MercadoPago no configurado" mientras falte MP_ACCESS_TOKEN o API_PUBLIC_URL.
# Detalle completo + tropiezos comunes: docs/planes-y-suscripciones.md §12
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=

# WEB_PUBLIC_URL: a dónde vuelve el navegador tras pagar (back_urls).
# API_PUBLIC_URL: a dónde le llega el webhook a MercadoPago (notification_url)
# — NUNCA puede ser localhost, MercadoPago tiene que alcanzarla desde internet.
#
# --- Local (pnpm dev, cada dev con su propio túnel) ---
# WEB_PUBLIC_URL=http://localhost:5173
# API_PUBLIC_URL=https://tu-tunel-personal.ngrok-free.app   (de `ngrok http 3000`)
#
# --- Docker (docker compose, dominio ngrok fijo compartido del equipo) ---
# Un solo túnel expone todo el stack (web proxea /api al contenedor api): usa
# el MISMO dominio en ambas variables, con esquema https://, igual al
# NGROK_DOMAIN que pusiste en el ".env" de la RAÍZ del repo (no este archivo).
WEB_PUBLIC_URL=https://tu-dominio.ngrok-free.app
API_PUBLIC_URL=https://tu-dominio.ngrok-free.app
