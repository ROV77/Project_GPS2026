# Solo para `pnpm --filter web dev` (Vite). Docker NO usa este archivo: usa
# el VITE_API_URL del ".env" de la raíz, pasado como build arg (ver
# docker-compose.yml y apps/web/Dockerfile).
#
# En desarrollo se deja vacío: el front pega a '/api' y Vite la redirige a
# http://localhost:3000 (ver proxy en vite.config.ts).
VITE_API_URL=
