# Variables para docker-compose.yml (NO confundir con apps/api/.env, que es
# el .env de la aplicación — este es solo para levantar el stack con Docker).
# Copia este archivo a ".env" en la raíz y complétalo. No se commitea.

# Tu authtoken de ngrok (dashboard.ngrok.com/get-started/your-authtoken).
# OJO: es el authtoken, no el "Domain" ni ningún id que empiece con "cr_".
NGROK_AUTHTOKEN=

# Tu dominio estático gratis de ngrok (dashboard.ngrok.com/domains),
# ej: tu-nombre.ngrok-free.app — SIN "https://" acá, docker-compose.yml ya
# le agrega el esquema. Debe ser el MISMO valor (con https:// esta vez) que
# pongas en WEB_PUBLIC_URL / API_PUBLIC_URL de apps/api/.env, o el navegador
# entra por un dominio y el back_url/webhook de MercadoPago apunta a otro.
NGROK_DOMAIN=

# URL pública de la API vista desde el navegador. Como todo queda detrás del
# mismo túnel ngrok (web proxea /api al contenedor api), déjala vacía: el
# front pega a rutas relativas "/api" igual que en local.
VITE_API_URL=
